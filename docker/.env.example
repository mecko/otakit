# Template for .env. Generate it with init-env.mjs (see README), which fills in
# every secret below with fresh random values; copy this file by hand only if
# you must.

# ── Image ────────────────────────────────────────────────────────────────────
# Pin a release tag or digest instead of latest for reproducible upgrades.
OTAKIT_IMAGE=ghcr.io/mecko/otakit-console:latest

# ── Network ──────────────────────────────────────────────────────────────────
# 127.0.0.1 keeps everything on this machine. To test on a phone, set your LAN
# IP here and in both URLs below (devices must reach the S3 URL).
OTAKIT_BIND_ADDRESS=127.0.0.1
# The console's public origin. The published image is built for
# http://localhost:3000; see README before changing it.
OTAKIT_URL=http://localhost:3000
# RustFS (S3 storage) as seen from outside Docker: presigned uploads and the CDN base URL.
OTAKIT_S3_URL=http://localhost:9000

# ── Secrets (generated) ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=
S3_ACCESS_KEY=otakit-admin
S3_SECRET_KEY=
S3_BUCKET=otakit-bundles
BETTER_AUTH_SECRET=
SECRET_KEY=
CRON_SECRET=
DATA_ENCRYPTION_KEY=
MANIFEST_SIGNING_KID=
# PKCS#8 PEM, newlines written as \n inside double quotes.
MANIFEST_SIGNING_KEY=""

# ── Optional ─────────────────────────────────────────────────────────────────
# Without Resend, sign-in codes appear in `docker compose logs console`.
RESEND_API_KEY=
EMAIL_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Token from Zero Trust > Networks > Tunnels; used by `docker compose --profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional services to run: events (device analytics), tunnel. Comma-separated.
COMPOSE_PROFILES=
# Tinybird Local tokens for the events profile; `init-env.mjs --events` fills them in.
TINYBIRD_TOKEN=
TINYBIRD_USER_TOKEN=
